{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"lib": [
			"ESNext"
		],
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"moduleResolution": "nodenext"
	},
	"include": [
		"*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
